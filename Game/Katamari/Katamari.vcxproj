<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{66BCFD2D-77A1-4F9C-97A5-A95D097368FE}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion><PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <EngineEnableAssimp Condition="'$(EngineEnableAssimp)'==''">false</EngineEnableAssimp>
  <EngineEnableJolt Condition="'$(EngineEnableJolt)'=='' and Exists('..\..\Engine\vcpkg_installed\x64-windows\include\Jolt\Jolt.h')">true</EngineEnableJolt>
  <EngineEnableJolt Condition="'$(EngineEnableJolt)'==''">false</EngineEnableJolt>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup>
    <VcpkgEnableManifest>$(EngineEnableAssimp)</VcpkgEnableManifest>
    <VcpkgEnabled>$(EngineEnableAssimp)</VcpkgEnabled>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)..\..\Engine\</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(MSBuildThisFileDirectory)..\..\Engine\vcpkg_installed\</VcpkgInstalledDir>
  </PropertyGroup>
  <Import Project="..\..\Engine\BuildSupport\VcpkgRoot.props" />
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props" Condition="'$(EngineEnableAssimp)'=='true' and Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props')" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\..\Engine\BuildSupport\Cpp.props" />
  <PropertyGroup><OutDir>$(RepositoryRoot)Game\build\$(Platform)\$(Configuration)\Katamari\</OutDir><IntDir>$(RepositoryRoot)Game\build\obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir><LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory></PropertyGroup>
  <ItemDefinitionGroup><ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\Common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile></ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\FBXComponentWithCollision.cpp" />
    <ClInclude Include="Source\FBXComponentWithCollision.h" />
    <ClCompile Include="Source\KatamariGame.cpp" />
    <ClInclude Include="Source\KatamariGame.h" />
    <ClCompile Include="Source\KatamatiSphereComponent.cpp" />
    <ClInclude Include="Source\KatamatiSphereComponent.h" />
    <ClCompile Include="Source\Main.cpp" />
    <GameContent Include="Content\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Engine\Engine.vcxproj">
      <Project>{90A42B03-FDD9-4E98-834D-49B44E58C029}</Project>
    </ProjectReference>
  </ItemGroup>
  <Target Name="RequireKatamariImporter" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EngineEnableAssimp)'!='true'" Text="Katamari requires Assimp. Install vcpkg, set VCPKG_ROOT, then build with -EnableAssimp. No substitute scene is provided." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" Condition="'$(EngineEnableAssimp)'=='true' and Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets')" />
  <Target Name="RequireAssimpDependencies" BeforeTargets="PrepareForBuild" Condition="'$(EngineEnableAssimp)'=='true'">
    <Error Condition="!Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props')" Text="EngineEnableAssimp requires vcpkg. Set VCPKG_ROOT or /p:VcpkgRoot to the installed vcpkg directory." />
  </Target>
  <Import Project="..\..\Engine\BuildSupport\Content.targets" />
  <Target Name="DeployGameContent" AfterTargets="Build">
    <Copy SourceFiles="RequiredFiles.txt" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameContent)" DestinationFiles="@(GameContent->'$(OutDir)GameContent\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="..\..\Engine\BuildSupport\ComponentGeneration.targets" />

  <ItemDefinitionGroup Condition="'$(EngineEnableJolt)'=='true' and '$(Configuration)'=='Debug'"><Link><AdditionalDependencies>$(RepositoryRoot)Engine/vcpkg_installed/x64-windows/debug/lib/Jolt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EngineEnableJolt)'=='true' and '$(Configuration)'=='Release'"><Link><AdditionalDependencies>$(RepositoryRoot)Engine/vcpkg_installed/x64-windows/lib/Jolt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
</Project>
