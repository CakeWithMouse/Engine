<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{0DF40264-80AB-4D4F-B271-3D0AE7A62B9E}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion><PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <EngineEnableAssimp Condition="'$(EngineEnableAssimp)'==''">false</EngineEnableAssimp>
  <EngineEnableJolt Condition="'$(EngineEnableJolt)'=='' and Exists('..\..\Engine\vcpkg_installed\x64-windows\include\Jolt\Jolt.h')">true</EngineEnableJolt>
  <EngineEnableJolt Condition="'$(EngineEnableJolt)'==''">false</EngineEnableJolt>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\..\Engine\BuildSupport\Cpp.props" />
  <PropertyGroup><OutDir>$(RepositoryRoot)Game\build\$(Platform)\$(Configuration)\</OutDir><IntDir>$(RepositoryRoot)Game\build\obj\$(Platform)\$(Configuration)\EngineLauncher\</IntDir></PropertyGroup>
  <ItemGroup><ClCompile Include="Source\Main.cpp" /><ClCompile Include="../../Engine/Runtime/Project.cpp" /><ResourceCompile Include="Source/Launcher.rc"><AdditionalOptions>/c65001 %(AdditionalOptions)</AdditionalOptions></ResourceCompile><ClInclude Include="Source\Catalog.h" /></ItemGroup>
  <ItemDefinitionGroup><Link><SubSystem>Windows</SubSystem><AdditionalDependencies>gdiplus.lib;shell32.lib;ole32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
  <ItemGroup><ProjectReference Include="../../Engine/Runtime/EngineRuntime.vcxproj"><Project>{30B3ACB8-B4EF-5CF4-8E65-FA5CB8AC1DC6}</Project><LinkLibraryDependencies>false</LinkLibraryDependencies></ProjectReference></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Bundled tutorials the launcher lists as «Туториал: …». Before the SDK: that step needs the v142 tools. -->
  <Target Name="DeployTutorials" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Game/AiTutorial/Create.ps1&quot; -Destination &quot;$(OutDir)Tutorials\AiTutorial&quot; -Runtime &quot;$(OutDir)Runtime&quot; -Bundled" />
  </Target>
  <Target Name="DeployProjectSdk" AfterTargets="DeployTutorials">
    <PropertyGroup>
      <ProjectSdkOptions Condition="'$(Configuration)'=='Debug'">-UseBuildToolset</ProjectSdkOptions>
    </PropertyGroup>
    <MSBuild Projects="../../Engine/Tools/ComponentGenerator/ComponentGenerator.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);PlatformToolset=$(PlatformToolset)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Engine/BuildSupport/New-ProjectSdk.ps1&quot; -Runtime &quot;$(OutDir)Runtime&quot; -Configuration $(Configuration) -PlatformToolset $(PlatformToolset) -Assimp $(EngineEnableAssimp) $(ProjectSdkOptions)" />
  </Target>


  <ItemDefinitionGroup Condition="'$(EngineEnableJolt)'=='true' and '$(Configuration)'=='Debug'"><Link><AdditionalDependencies>$(RepositoryRoot)Engine/vcpkg_installed/x64-windows/debug/lib/Jolt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EngineEnableJolt)'=='true' and '$(Configuration)'=='Release'"><Link><AdditionalDependencies>$(RepositoryRoot)Engine/vcpkg_installed/x64-windows/lib/Jolt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
</Project>
