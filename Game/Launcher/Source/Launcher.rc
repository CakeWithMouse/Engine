#include <windows.h>
200 DIALOGEX 0, 0, 350, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Создать проект"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Название проекта", -1, 12, 12, 320, 12
    EDITTEXT 201, 12, 27, 325, 15, ES_AUTOHSCROLL
    LTEXT "Новая папка проекта (будет создана внутри выбранной папки)", -1, 12, 49, 325, 12
    EDITTEXT 202, 12, 65, 267, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Обзор…", 203, 284, 64, 53, 17
    LTEXT "Готовая сцена: земля, куб и свет. Версия движка сохраняется в проекте.", -1, 12, 89, 325, 24
    CONTROL "Проект с C++ (нужны Visual Studio C++ tools)", 204, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 115, 325, 15
    DEFPUSHBUTTON "Создать", IDOK, 223, 141, 55, 17
    PUSHBUTTON "Отмена", IDCANCEL, 283, 141, 54, 17
END

210 DIALOGEX 0, 0, 390, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Новая версия движка"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 211, 12, 12, 366, 159
    DEFPUSHBUTTON "Обновить копию и запустить", IDYES, 12, 179, 170, 20
    PUSHBUTTON "Открыть на прежней версии", IDNO, 190, 179, 188, 20
    PUSHBUTTON "Отмена", IDCANCEL, 308, 201, 70, 17
END

