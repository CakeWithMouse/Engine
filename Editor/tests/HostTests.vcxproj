<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup Label="ProjectConfigurations">
        <ProjectConfiguration Include="Debug|x64">
            <Configuration>Debug</Configuration>
            <Platform>x64</Platform>
        </ProjectConfiguration>
        <ProjectConfiguration Include="Release|x64">
            <Configuration>Release</Configuration>
            <Platform>x64</Platform>
        </ProjectConfiguration>
    </ItemGroup>

    <PropertyGroup Label="Globals">
        <ProjectGuid>{A81C21B2-783E-4D88-B319-C82D4F381081}</ProjectGuid>
        <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    </PropertyGroup>

    <Import Project="$(VCTargetsPath)/Microsoft.Cpp.Default.props"/>

    <PropertyGroup Label="Configuration">
        <ConfigurationType>Application</ConfigurationType>
        <PlatformToolset>v145</PlatformToolset>
        <CharacterSet>Unicode</CharacterSet>
        <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
        <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
    </PropertyGroup>

    <Import Project="$(VCTargetsPath)/Microsoft.Cpp.props"/>
    <Import Project="..\..\Engine\BuildSupport\Cpp.props"/>

    <PropertyGroup>
        <GameConfig Condition="'$(GameConfig)'==''">$(Configuration)</GameConfig>
        <OutDir>$(RepositoryRoot)Game/build/$(Platform)/$(GameConfig)/Runtime/</OutDir>
        <IntDir>$(RepositoryRoot)Game/build/$(Platform)/$(Configuration)/obj/HostTests/</IntDir>
        <TargetName>HostTests</TargetName>
    </PropertyGroup>

    <PropertyGroup>
        <QtInstallDir Condition="'$(QtInstallDir)'=='' AND '$(QTDIR)'!=''">$(QTDIR)</QtInstallDir>
        <QtInstallDir Condition="'$(QtInstallDir)'=='' AND Exists('$(MSBuildThisFileDirectory)../ThirdParty/Qt/6.7.3/msvc2019_64/bin/moc.exe')">$(MSBuildThisFileDirectory)../ThirdParty/Qt/6.7.3/msvc2019_64</QtInstallDir>
        <QtInstallDir Condition="'$(QtInstallDir)'==''">$(MSBuildThisFileDirectory)..\ThirdParty\Qt6.7</QtInstallDir>
        <QtUseDebugLibraries Condition="'$(Configuration)'=='Debug' AND Exists('$(QtInstallDir)/lib/Qt6Cored.lib')">true</QtUseDebugLibraries>
        <QtLibSuffix Condition="'$(QtUseDebugLibraries)'=='true'">d</QtLibSuffix>
        <QtLibSuffix Condition="'$(QtUseDebugLibraries)'!='true'"></QtLibSuffix>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ClCompile>
            <AdditionalIncludeDirectories>$(QtInstallDir)/include;$(QtInstallDir)/include/QtCore;$(ProjectDir)../Host;$(ProjectDir)../Include;$(RepositoryRoot)Engine/Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
            <PreprocessorDefinitions>QT_CORE_LIB;UNICODE;_UNICODE;WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <LanguageStandard>stdcpp17</LanguageStandard>
            <MultiProcessorCompilation>true</MultiProcessorCompilation>
            <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
        </ClCompile>
        <Link>
            <SubSystem>Console</SubSystem>
            <AdditionalDependencies>$(QtInstallDir)\lib\Qt6Core$(QtLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
        </Link>
    </ItemDefinitionGroup>

    <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' AND '$(QtUseDebugLibraries)'!='true'">
        <ClCompile>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <PreprocessorDefinitions>NDEBUG;$([System.String]::Copy('%(PreprocessorDefinitions)').Replace('_DEBUG;', '').Replace(';_DEBUG', ''))</PreprocessorDefinitions>
        </ClCompile>
    </ItemDefinitionGroup>

    <ItemGroup>
        <ClCompile Include="HostTests.cpp"/>
        <ClCompile Include="../Source/QtHost.cpp"/>
        <ClCompile Include="../Host/ViewportCommandHandler.cpp"/>
        <ClCompile Include="../Host/AssetCommandHandler.cpp"/>
        <ClCompile Include="../Host/EditorHistory.cpp"/>
        <ClCompile Include="../Host/SceneCommandHandler.cpp"/>
    </ItemGroup>

    <Import Project="$(VCTargetsPath)/Microsoft.Cpp.targets"/>
</Project>

