        <IntDir Condition="'$(EditorUiTest)'=='true'">$(RepositoryRoot)Game/build/$(Platform)/$(Configuration)/obj/EditorUiTests/</IntDir>
    </PropertyGroup>

    <!-- ===== Qt: подставьте свою версию/путь ===== -->
    <PropertyGroup>
        <QtInstallDir Condition="'$(QtInstallDir)'=='' AND '$(QTDIR)'!=''">$(QTDIR)</QtInstallDir>
        <QtInstallDir Condition="'$(QtInstallDir)'=='' AND Exists('$(MSBuildThisFileDirectory)ThirdParty/Qt/6.7.3/msvc2019_64/bin/moc.exe')">$(MSBuildThisFileDirectory)ThirdParty/Qt/6.7.3/msvc2019_64</QtInstallDir>
        <QtInstallDir Condition="'$(QtInstallDir)'==''">$(MSBuildThisFileDirectory)ThirdParty\Qt6.7</QtInstallDir>
        <QtUseDebugLibraries Condition="'$(Configuration)'=='Debug' AND Exists('$(QtInstallDir)/lib/Qt6Widgetsd.lib')">true</QtUseDebugLibraries>
        <QtLibSuffix Condition="'$(QtUseDebugLibraries)'=='true'">d</QtLibSuffix>
        <QtLibSuffix Condition="'$(QtUseDebugLibraries)'!='true'"></QtLibSuffix>
    </PropertyGroup>

    <!-- ===== Qt-настройки (кладем ПОСЛЕ Cpp.props, чтобы переопределить/дополнить) ===== -->
    <ItemDefinitionGroup>
        <ClCompile>
            <!-- %(AdditionalIncludeDirectories) берёт include-пути из Cpp.props, сверху кладём Qt -->
            <AdditionalIncludeDirectories>$(QtInstallDir)/include;$(QtInstallDir)/include/QtWidgets;$(QtInstallDir)/include/QtGui;$(QtInstallDir)/include/QtCore;$(QtInstallDir)/include/QtSvg;$(IntDir)moc;$(ProjectDir)Core;$(ProjectDir)Host;$(ProjectDir)UI;$(ProjectDir)Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
            <PreprocessorDefinitions>QT_WIDGETS_LIB;QT_GUI_LIB;QT_CORE_LIB;QT_SVG_LIB;UNICODE;_UNICODE;WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <LanguageStandard>stdcpp17</LanguageStandard>
            <ExceptionHandling>Sync</ExceptionHandling>
            <MultiProcessorCompilation>true</MultiProcessorCompilation>
            <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
        </ClCompile>
        <Link>
            <AdditionalLibraryDirectories>$(QtInstallDir)/lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
            <!-- %(AdditionalDependencies) сохраняет всё, что дал Cpp.props -->
            <AdditionalDependencies>$(QtInstallDir)\lib\Qt6Widgets$(QtLibSuffix).lib;$(QtInstallDir)\lib\Qt6Gui$(QtLibSuffix).lib;$(QtInstallDir)\lib\Qt6Core$(QtLibSuffix).lib;$(QtInstallDir)\lib\Qt6Svg$(QtLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
        </Link>
        <PostBuildEvent>
            <Message>windeployqt: Qt runtime -&gt; $(OutDir)</Message>
            <Command>"$(QtInstallDir)/bin/windeployqt.exe" --no-translations --no-opengl-sw "$(TargetPath)"</Command>
        </PostBuildEvent>
    </ItemDefinitionGroup>

    <!-- ===== Debug: /MDd + отладочная Qt (Qt6Widgetsd.lib) ===== -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' AND '$(QtUseDebugLibraries)'=='true'">
        <ClCompile>
            <Optimization>Disabled</Optimization>
            <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
            <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
        </ClCompile>
    </ItemDefinitionGroup>

    <!-- Some SDKs ship only release Qt. Keep symbols but match its CRT/iterator ABI.
         Editor allocates and frees its own objects; the host boundary is the C ModuleApi. -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' AND '$(QtUseDebugLibraries)'!='true'">
        <ClCompile>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <PreprocessorDefinitions>NDEBUG;$([System.String]::Copy('%(PreprocessorDefinitions)').Replace('_DEBUG;', '').Replace(';_DEBUG', ''))</PreprocessorDefinitions>
        </ClCompile>
    </ItemDefinitionGroup>

    <!-- ===== Release: /MD + релизная Qt, оптимизации для поставки ===== -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
        <ClCompile>
            <Optimization>MaxSpeed</Optimization>
            <FunctionLevelLinking>true</FunctionLevelLinking>
            <IntrinsicFunctions>true</IntrinsicFunctions>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        </ClCompile>
        <Link>
            <OptimizeReferences>true</OptimizeReferences>
            <EnableCOMDATFolding>true</EnableCOMDATFolding>
            <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
        </Link>
    </ItemDefinitionGroup>

    <!-- ===== RelWithDebInfo: /MD + РЕЛИЗНАЯ Qt, но /Od и полный PDB ===== -->
    <!-- Ключевое: NDEBUG (не _DEBUG!), иначе _ITERATOR_DEBUG_LEVEL/QT_NO_DEBUG -->
    <!-- разъедутся с релизными Qt-библиотеками (LNK2038 / порча кучи). -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='RelWithDebInfo'">
        <ClCompile>
            <Optimization>Disabled</Optimization>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        </ClCompile>
    </ItemDefinitionGroup>

