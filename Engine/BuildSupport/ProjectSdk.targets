<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="GenerateProjectTypes" BeforeTargets="ClCompile" Condition="'$(DesignTimeBuild)'!='true'">
    <Error Condition="!Exists('$(EngineSdk)\Sdk.json')" Text="Matching Engine SDK is missing. Use project Build.ps1." />
    <Error Condition="'$(EnginePinnedConfiguration)'!='' and '$(Configuration)'!='$(EnginePinnedConfiguration)'" Text="Configuration does not match Engine.lock.json. Upgrade a project copy explicitly." />
    <MakeDir Directories="$(EngineGeneratedDir)" />
    <WriteLinesToFile File="$(EngineGeneratedDir)roots.txt" Lines="$(MSBuildProjectDirectory)\Source" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="&quot;$(EngineSdk)\Tools\ComponentGenerator.exe&quot; &quot;$(EngineGeneratedDir)roots.txt&quot; &quot;$(EngineGeneratedDir).&quot; Project" />
  </Target>
  <Target Name="DeployProjectCatalog" AfterTargets="Build">
    <Copy SourceFiles="$(EngineGeneratedDir)ProjectTypes.tsv" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
