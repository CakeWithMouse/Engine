<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Public SDK include paths; consumers never need Engine/Source. -->
  <ItemDefinitionGroup><ClCompile>
    <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Include;$(MSBuildThisFileDirectory)ThirdParty\GLM-master;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
  </ClCompile></ItemDefinitionGroup>
</Project>
