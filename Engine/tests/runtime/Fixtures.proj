    <Fixture Include="WrongKind"><Case>2</Case></Fixture>
    <Fixture Include="MissingExport"><Case>3</Case></Fixture>
    <Fixture Include="FailGameStart"><Case>4</Case></Fixture>
    <Fixture Include="FailEditorStart"><Case>5</Case></Fixture>
    <Fixture Include="RequestExit"><Case>6</Case></Fixture>
    <Fixture Include="FailUpdate"><Case>7</Case></Fixture>
