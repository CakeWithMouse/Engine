  <Target Name="Build">
    <MSBuild Projects="Fixture.vcxproj" Properties="Configuration=$(Configuration);Platform=$(Platform);PlatformToolset=$(PlatformToolset);FixtureName=%(Fixture.Identity);FixtureCase=%(Fixture.Case)" />
