file(MAKE_DIRECTORY "${WORK}/Исходники with spaces" "${WORK}/Output with spaces")
file(WRITE "${WORK}/roots.txt" "${WORK}/Исходники with spaces\n")
file(WRITE "${WORK}/Исходники with spaces/Example.h" "ENGINE_COMPONENT(\"Example\")\nclass Example : public GameComponent {};\n")
execute_process(COMMAND "${GENERATOR}" "${WORK}/roots.txt" "${WORK}/Output with spaces" Portable RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${WORK}/Output with spaces/GeneratedComponents.cpp")
    message(FATAL_ERROR "Component generator failed: ${result}")
endif()
file(READ "${WORK}/Output with spaces/GeneratedComponents.cpp" generated)
if(NOT generated MATCHES "EngineGenerated::Portable" OR NOT generated MATCHES "Create<::Example>")
    message(FATAL_ERROR "Generated catalog has wrong namespace")
endif()
file(TIMESTAMP "${WORK}/Output with spaces/GeneratedComponents.cpp" before "%s.%f")
execute_process(COMMAND "${GENERATOR}" "${WORK}/roots.txt" "${WORK}/Output with spaces" Portable RESULT_VARIABLE result)
file(TIMESTAMP "${WORK}/Output with spaces/GeneratedComponents.cpp" after "%s.%f")
if(NOT result EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Unchanged generated output was rewritten")
endif()
file(WRITE "${WORK}/Исходники with spaces/Example.h" "// Annotation removed.\n")
execute_process(COMMAND "${GENERATOR}" "${WORK}/roots.txt" "${WORK}/Output with spaces" Portable RESULT_VARIABLE result)
file(READ "${WORK}/Output with spaces/GeneratedComponents.cpp" generated)
if(NOT result EQUAL 0 OR generated MATCHES "Create<::Example>")
    message(FATAL_ERROR "Removed annotation remained in the catalog")
endif()
execute_process(COMMAND "${GENERATOR}" "${WORK}/roots.txt" "${WORK}/Output with spaces" invalid-catalog RESULT_VARIABLE result)
if(result EQUAL 0)
    message(FATAL_ERROR "Invalid catalog accepted")
endif()
