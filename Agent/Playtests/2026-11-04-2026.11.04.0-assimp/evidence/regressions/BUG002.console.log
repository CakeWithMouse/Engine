    "style": "\nQWidget {\n    color: #ECEFF4;\n    selection-background-color: #DC2626;\n    selection-color: #FFFFFF;\n    outline: none;\n}\nQMainWindow, QDialog {\n    background-color: #181A1F;\n}\nQMenuBar {\n    background-color: #181A1F;\n    border-bottom: 1px solid #2C313A;\n    padding: 2px 6px;\n    font-size: 12px;\n}\nQMenuBar::item {\n    background: transparent;\n    padding: 4px 8px;\n    border-radius: 4px;\n    color: #ABB2BF;\n}\nQMenuBar::item:selected {\n    background-color: #282C34;\n    color: #ECEFF4;\n}\nQMenu {\n    background-color: #20232A;\n    border: 1px solid #2C313A;\n    border-radius: 4px;\n    padding: 4px;\n}\nQMenu::item {\n    padding: 5px 24px 5px 12px;\n    border-radius: 3px;\n    color: #ECEFF4;\n}\nQMenu::item:selected {\n    background-color: #DC2626;\n    color: #FFFFFF;\n}\nQMenu::separator {\n    height: 1px;\n    background-color: #2C313A;\n    margin: 4px 6px;\n}\nQToolBar {\n    background-color: #181A1F;\n    border-bottom: 1px solid #2C313A;\n    spacing: 4px;\n    padding: 3px 6px;\n}\nQToolButton {\n    background-color: #21252B;\n    border: 1px solid #2C313A;\n    border-radius: 4px;\n    padding: 4px 8px;\n    color: #ECEFF4;\n}\nQToolButton:hover {\n    background-color: #282C34;\n    border-color: #3E4451;\n}\nQToolButton:pressed, QToolButton:checked {\n    background-color: #1C2026;\n    border-color: #DC2626;\n}\nQPushButton {\n    background-color: #21252B;\n    border: 1px solid #2C313A;\n    border-radius: 4px;\n    padding: 5px 12px;\n    color: #ECEFF4;\n    font-weight: 500;\n}\nQPushButton:hover {\n    background-color: #282C34;\n    border-color: #3E4451;\n}\nQPushButton:pressed {\n    background-color: #1C2026;\n    border-color: #DC2626;\n}\nQPushButton:disabled {\n    color: #5C6370;\n    border-color: #2C313A;\n}\nQLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {\n    background-color: #14161A;\n    border: 1px solid #2C313A;\n    border-radius: 4px;\n    padding: 3px 6px;\n    color: #ECEFF4